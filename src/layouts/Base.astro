---
// Base layout — SEO, fonts, mode engine bootstrap, nav + footer + terminal overlay.
// Every page shares this shell; only the landing plays the intro beat.
// ClientRouter gives the "turning the page" feel between chapters.
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500-italic.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { profile } from '../content/profile';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TerminalOverlay from '../components/TerminalOverlay.astro';
import SkillPopover from '../components/SkillPopover.astro';
import ResumeViewer from '../components/ResumeViewer.astro';

interface Props {
  title?: string;
  description?: string;
  intro?: boolean;
  bare?: boolean; // 404 page: no nav/footer chrome
}

const {
  title = 'Aaron Chakraborty · AI/ML Security Engineer',
  description = 'I build AI systems, and I break them. 567M-param MoE LLM trained from scratch · production XSS disclosed · AIR 45 Pentathon 2025 · B.Tech CSE @ KIIT.',
  intro = false,
  bare = false,
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  email: profile.email.replace('mailto:', ''),
  url: 'https://aaron-631.github.io',
  image: 'https://aaron-631.github.io/aaron.jpg',
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.x, profile.links.tryhackme],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Kalinga Institute of Industrial Technology' },
  knowsAbout: ['Machine Learning', 'LLM Training', 'Penetration Testing', 'AI Security', 'Distributed Systems'],
};

const canonical = new URL(Astro.url.pathname, 'https://aaron-631.github.io').href;
---

<!doctype html>
<html lang="en" data-mode="build">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0b" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://aaron-631.github.io/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://aaron-631.github.io/og.png" />
    <meta name="twitter:creator" content="@AaronChakr47884" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />

    <!-- mode bootstrap: apply persisted mode before first paint (no flash).
         Re-applied after every page swap too — the router replaces <html> attrs. -->
    <script is:inline>
      (function () {
        function applyMode() {
          try {
            const m = localStorage.getItem('mode');
            if (m === 'break' || m === 'build') document.documentElement.dataset.mode = m;
            if (sessionStorage.getItem('seen')) document.documentElement.classList.add('intro-skip');
          } catch {}
        }
        applyMode();
        document.addEventListener('astro:after-swap', applyMode);
      })();
    </script>
  </head>
  <body class="grain">
    {
      /* one quiet beat before anything asks for attention */
      intro && (
        <div id="intro" aria-hidden="true">
          <p class="intro-name">Aaron Chakraborty</p>
          <div class="intro-rule" />
          <p class="intro-tag">builds ai systems · breaks ai systems</p>
        </div>
      )
    }
    {!bare && <Nav />}
    {!bare && <div id="read-progress" aria-hidden="true"></div>}
    <slot />
    {!bare && <Footer />}
    <TerminalOverlay />
    <SkillPopover />
    <ResumeViewer />

    <script>
      // everything here re-wires on astro:page-load, which fires on first
      // load AND after every client-side page turn.
      function init() {
        // intro: dismiss after the beat (or instantly on click), remember per session
        const intro = document.getElementById('intro');
        if (intro && !document.documentElement.classList.contains('intro-skip')) {
          // hold the hero's entrance until the curtain lifts
          document.documentElement.classList.add('intro-wait');
          const done = () => {
            intro.classList.add('out');
            document.documentElement.classList.remove('intro-wait');
            try { sessionStorage.setItem('seen', '1'); } catch {}
            setTimeout(() => intro.remove(), 700);
          };
          intro.addEventListener('click', done);
          setTimeout(done, 2100);
        } else {
          intro?.remove();
        }

        // scroll reveal — IntersectionObserver, once per element,
        // staggered slightly within each visible batch so sections breathe in
        const io = new IntersectionObserver(
          (entries) => {
            let i = 0;
            for (const e of entries) {
              if (e.isIntersecting) {
                const el = e.target as HTMLElement;
                el.style.transitionDelay = `${Math.min(i++ * 70, 280)}ms`;
                el.classList.add('in');
                // clear the stagger once revealed, so hover transitions stay instant
                setTimeout(() => (el.style.transitionDelay = ''), 1000);
                io.unobserve(el);
              }
            }
          },
          { threshold: 0.12 }
        );
        document.querySelectorAll('.reveal:not(.in)').forEach((el) => io.observe(el));

        // live IST clocks — anything carrying [data-ist]
        const clocks = document.querySelectorAll('[data-ist]');
        const tick = () => {
          const t = new Date().toLocaleTimeString('en-IN', {
            timeZone: 'Asia/Kolkata',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
          });
          clocks.forEach((c) => (c.textContent = t));
        };
        if (clocks.length) tick();

        // reading progress hairline — the "how far into the chapter am i" cue
        const bar = document.getElementById('read-progress');
        if (bar) {
          const onScroll = () => {
            const h = document.documentElement;
            const max = h.scrollHeight - h.clientHeight;
            bar.style.width = max > 0 ? `${(h.scrollTop / max) * 100}%` : '0';
          };
          if (progressHandler) window.removeEventListener('scroll', progressHandler);
          progressHandler = onScroll;
          window.addEventListener('scroll', onScroll, { passive: true });
          onScroll();
        }
        return tick;
      }

      let progressHandler: (() => void) | undefined;

      let clockTimer: ReturnType<typeof setInterval> | undefined;
      document.addEventListener('astro:page-load', () => {
        const tick = init();
        if (clockTimer) clearInterval(clockTimer);
        clockTimer = setInterval(tick, 30_000);
      });

      // for the ones who open devtools first. respect. (once per visit)
      console.log(
        '%caaron@portfolio:~$ %cyou checked the console. good instinct.\n' +
          'the real easter eggs live in the terminal. press ~ and start digging.\n' +
          'hint: ls -la shows more than ls.',
        'color:#ffb454;font-family:monospace',
        'color:#9d9b94;font-family:monospace'
      );
    </script>
  </body>
</html>
