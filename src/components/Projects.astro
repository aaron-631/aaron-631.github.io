---
// Projects — VantaLLM flagship dossier + detailed cards + lab row.
// Card order re-lenses per mode via CSS `order`.
import { projects, lab } from '../content/projects';

const flagship = projects.find((p) => p.flagship)!;
const rest = projects.filter((p) => !p.flagship);

const ARCH = `  ┌────────────────────────────────────────────┐
  │ VantaLLM · decoder-only · 567,068,416 params│
  ├────────────────────────────────────────────┤
  │ tok(151,003) → emb → 12× [ RMSNorm         │
  │   → GQA + RoPE (shared lazy cache)         │
  │   → dense FFN ⇄ MoE 16e top-2              │
  │     (batched grouped-GEMM, cap=1.25) ]     │
  │ → RMSNorm → lm_head                        │
  ├────────────────────────────────────────────┤
  │ train: DDP / DeepSpeed ZeRO-2·3 · bf16     │
  │ serve: FastAPI · SSE · persona routing     │
  └────────────────────────────────────────────┘`;
---

<section id="projects" class="border-t border-line bg-ink-2/30">
  <div class="mx-auto max-w-6xl px-5 py-24">
    <p class="label-mono reveal mb-3"><span class="idx">// 02</span> <span data-swap data-build="— things i built" data-break="— attack & defense tooling"></span></p>
    <h2 class="h-serif reveal mb-14 text-4xl sm:text-5xl">
      <span class="pj-build">Built end-to-end,<br />not assembled.</span>
      <span class="pj-break">Tools that find what<br />ships broken.</span>
    </h2>

    <!-- flagship dossier -->
    <article id="vantallm" class="reveal grid grid-cols-1 gap-8 border border-line bg-ink p-7 md:p-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h3 class="font-mono text-2xl">{flagship.name}</h3>
          <span class="rounded-sm border border-line px-2 py-0.5 font-mono text-[0.65rem] tracking-wider text-paper-dim uppercase">private repo</span>
          <span class="font-mono text-[0.65rem] tracking-wider text-accent uppercase">flagship</span>
        </div>
        <p class="mt-4 text-paper-dim">
          <span class="pj-build">{flagship.oneliner.build}</span>
          <span class="pj-break">{flagship.oneliner.break}</span>
        </p>
        <ul class="mt-5 space-y-2.5 text-[0.92rem] text-paper-dim">
          {flagship.points.map((p) => (
            <li class="flex gap-2.5">
              <span class="mt-[0.55rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
              <span>{p}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6 flex flex-wrap gap-2">
          {flagship.stack.map((s) => (
            <span class="rounded-sm bg-ink-3 px-2 py-1 font-mono text-[0.68rem] text-paper-dim">{s}</span>
          ))}
        </div>
        <div class="mt-6 flex flex-wrap gap-2" data-proofs>
          {flagship.proofs.map((pr, i) => (
            <button class="proof-chip" aria-expanded="false" data-proof-idx={i} data-detail={pr.detail} data-href={pr.href ?? ''}>
              {pr.label}
            </button>
          ))}
        </div>
        <div class="proof-detail mt-3 hidden" data-proof-out></div>
        <p class="mt-6 font-mono text-[0.75rem] text-paper-dim">
          → <a class="link" href={flagship.links[0].href}>{flagship.links[0].label}</a>
        </p>
      </div>
      <pre class="pane-body self-center overflow-x-auto rounded-md border border-line bg-ink-2 font-mono text-[0.68rem] leading-snug text-paper-dim sm:text-[0.75rem]" aria-label="VantaLLM architecture diagram">{ARCH}</pre>
    </article>

    <!-- supporting cards -->
    <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
      {
        rest.map((p) => (
          <article
            class="reveal flex flex-col border border-line bg-ink p-6 transition-colors hover:border-accent/50"
            data-card={p.id}
          >
            <div class="flex items-center justify-between">
              <h3 class="font-mono text-lg">{p.name}</h3>
              <span class={`font-mono text-[0.62rem] tracking-wider uppercase ${p.status === 'live' ? 't-ok' : 'text-paper-dim'}`}>
                {p.status}
              </span>
            </div>
            <p class="mt-3 flex-grow text-[0.9rem] text-paper-dim">
              <span class="pj-build">{p.oneliner.build}</span>
              <span class="pj-break">{p.oneliner.break}</span>
            </p>
            <ul class="mt-4 space-y-1.5 text-[0.82rem] text-paper-dim">
              {p.points.slice(0, 2).map((pt) => (
                <li class="flex gap-2">
                  <span class="mt-[0.5rem] h-px w-2.5 shrink-0 bg-accent" aria-hidden="true" />
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {p.stack.slice(0, 4).map((s) => (
                <span class="rounded-sm bg-ink-3 px-1.5 py-0.5 font-mono text-[0.62rem] text-paper-dim">{s}</span>
              ))}
            </div>
            <p class="mt-5 font-mono text-[0.72rem]">
              {p.links.map((l, i) => (
                <>
                  {i > 0 && <span class="text-line"> · </span>}
                  <a class="link" href={l.href} target="_blank" rel="noopener">{l.label}</a>
                </>
              ))}
            </p>
          </article>
        ))
      }
    </div>

    <!-- more in the lab -->
    <div class="reveal mt-10 border-t border-dashed border-line pt-6 font-mono text-[0.78rem] text-paper-dim">
      <span class="text-accent">more in the lab:</span>
      {lab.map((l, i) => (
        <>
          {i > 0 && ' · '}
          <a class="link" href={l.href} target="_blank" rel="noopener" title={l.note}>{l.name}</a>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .pj-break { display: none; }
  html[data-mode='break'] .pj-build { display: none; }
  html[data-mode='break'] .pj-break { display: inline; }
  /* BREAK mode: attack tooling leads */
  html[data-mode='break'] [data-card='argus'] { order: -2; }
  html[data-mode='break'] [data-card='reconforge'] { order: -1; }
</style>

<script>
  // proof chip expansion — one open at a time inside the dossier
  document.querySelectorAll('[data-proofs]').forEach((wrap) => {
    const out = wrap.parentElement?.querySelector('[data-proof-out]') as HTMLElement | null;
    if (!out) return;
    wrap.querySelectorAll<HTMLButtonElement>('.proof-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        wrap.querySelectorAll('.proof-chip').forEach((b) => b.setAttribute('aria-expanded', 'false'));
        if (open) {
          out.classList.add('hidden');
          return;
        }
        btn.setAttribute('aria-expanded', 'true');
        const href = btn.dataset.href;
        out.textContent = btn.dataset.detail ?? '';
        if (href) {
          const a = document.createElement('a');
          a.href = href;
          a.target = '_blank';
          a.rel = 'noopener';
          a.className = 'link';
          a.textContent = ' → open';
          out.appendChild(a);
        }
        out.classList.remove('hidden');
      });
    });
  });
</script>
