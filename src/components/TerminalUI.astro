---
// Terminal — overlay (opened with ~ / Ctrl+K) + embedded footer instance.
---

<!-- overlay -->
<div id="term-overlay" class="fixed inset-0 z-[70] hidden items-start justify-center bg-ink/80 p-4 pt-[12vh] backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Terminal">
  <div class="pane w-full max-w-2xl shadow-2xl">
    <div class="pane-bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="ml-2" id="term-title">aaron@portfolio — press esc to close</span>
    </div>
    <div class="pane-body h-[24rem] overflow-y-auto" id="term-out-overlay"></div>
    <div class="flex items-center gap-2 border-t border-line px-4 py-2.5 font-mono text-[0.8rem]">
      <span class="t-prompt" data-prompt>aaron@build:~$</span>
      <input
        id="term-in-overlay"
        class="w-full bg-transparent text-paper outline-none placeholder:text-paper-dim/40"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="help"
        aria-label="Terminal input"
      />
    </div>
  </div>
</div>

<!-- footer -->
<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-20">
    <p class="label-mono reveal mb-3"><span class="idx">// 08</span> — terminal</p>
    <h2 class="h-serif reveal mb-4 text-3xl sm:text-4xl">Prefer the command line?<br />Same here.</h2>
    <p class="reveal mb-10 max-w-md text-paper-dim text-[0.95rem]">
      This shell has been on my site since v1 — it's the one thing I refused to remove.
      The whole site is navigable from here. Start with <span class="font-mono text-accent">help</span> —
      and no, not everything is documented.
    </p>

    <div class="pane reveal max-w-2xl">
      <div class="pane-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="ml-2">aaron@portfolio</span>
      </div>
      <div class="pane-body h-[18rem] overflow-y-auto" id="term-out-embed"></div>
      <div class="flex items-center gap-2 border-t border-line px-4 py-2.5 font-mono text-[0.8rem]">
        <span class="t-prompt" data-prompt>aaron@build:~$</span>
        <input
          id="term-in-embed"
          class="w-full bg-transparent text-paper outline-none placeholder:text-paper-dim/40"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          placeholder="try: scan me"
          aria-label="Terminal input"
        />
      </div>
    </div>

    <div class="mt-16 flex flex-col items-start justify-between gap-4 border-t border-dashed border-line pt-6 font-mono text-[0.72rem] text-paper-dim sm:flex-row">
      <p>© 2026 Aaron Chakraborty · designed & written by me, in Bhubaneswar, mostly after midnight</p>
      <p>
        <a class="link" href="https://github.com/aaron-631/aaron-631.github.io" target="_blank" rel="noopener">view source</a>
        <span class="mx-2 text-line">·</span>
        <span data-swap data-build="mode: build" data-break="mode: break"></span>
      </p>
    </div>
  </div>
</footer>

<script>
  import { execute, complete } from './Terminal';
  import { getMode } from './mode';

  type Line = { text: string; cls?: string };

  function wire(outId: string, inId: string) {
    const out = document.getElementById(outId)!;
    const input = document.getElementById(inId) as HTMLInputElement;
    const hist: string[] = [];
    let hi = -1;

    const promptStr = () => `${getMode() === 'build' ? 'aaron@build' : 'aaron@break'}:~$`;

    function print(lines: Line[]) {
      for (const l of lines) {
        const p = document.createElement('p');
        p.className = l.cls ?? '';
        p.textContent = l.text || ' ';
        p.style.whiteSpace = 'pre-wrap';
        out.appendChild(p);
      }
      out.scrollTop = out.scrollHeight;
    }

    print([
      { text: 'VantaShell v2.0 — type help to begin.', cls: 't-dim' },
      { text: '' },
    ]);

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const v = input.value;
        if (v.trim()) {
          hist.unshift(v);
          hi = -1;
        }
        print([{ text: `${promptStr()} ${v}`, cls: 't-prompt' }]);
        const res = execute(v);
        if (res === 'CLEAR') out.innerHTML = '';
        else print(res);
        input.value = '';
      } else if (e.key === 'Tab') {
        e.preventDefault();
        const c = complete(input.value);
        if (c) input.value = c;
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (hi < hist.length - 1) input.value = hist[++hi];
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        input.value = hi > 0 ? hist[--hi] : ((hi = -1), '');
      }
    });
  }

  wire('term-out-embed', 'term-in-embed');
  wire('term-out-overlay', 'term-in-overlay');

  // overlay open/close
  const overlay = document.getElementById('term-overlay')!;
  const overlayInput = document.getElementById('term-in-overlay') as HTMLInputElement;

  function openTerm() {
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    setTimeout(() => overlayInput.focus(), 30);
  }
  function closeTerm() {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
  }

  document.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement).tagName;
    const typing = tag === 'INPUT' || tag === 'TEXTAREA';
    if ((e.key === '~' || e.key === '`') && !typing) {
      e.preventDefault();
      openTerm();
    } else if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      openTerm();
    } else if (e.key === 'Escape') {
      closeTerm();
    }
  });
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeTerm();
  });
  document.addEventListener('terminal:open', openTerm);

  // keep prompts in sync with mode
  const syncPrompts = () => {
    document.querySelectorAll('[data-prompt]').forEach((el) => {
      el.textContent = `${getMode() === 'build' ? 'aaron@build' : 'aaron@break'}:~$`;
    });
  };
  document.addEventListener('modechange', syncPrompts);
  syncPrompts();
</script>
