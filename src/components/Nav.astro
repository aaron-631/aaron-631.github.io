---
// Nav — typing logo, page links, BUILD/BREAK rocker, terminal hint.
const { pathname } = Astro.url;
const links = [
  { href: '/about/', label: 'about' },
  { href: '/work/', label: 'work' },
  { href: '/projects/', label: 'projects' },
  { href: '/writing/', label: 'writing' },
  { href: '/wall/', label: 'wall' },
  { href: '/contact/', label: 'contact' },
];
const isActive = (href: string) => pathname === href || pathname === href.slice(0, -1);
---

<nav
  class="fixed top-0 left-0 right-0 z-50 border-b border-line bg-ink/85 backdrop-blur-sm"
  aria-label="Primary"
>
  <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-baseline gap-[3px] font-mono text-lg text-paper" aria-label="Aaron Chakraborty, home">
      <span class="logo-type" data-logo>Aaron</span><span class="logo-block" aria-hidden="true"></span>
    </a>

    <!-- live local time — proof there's a human in Asia/Kolkata behind this -->
    <span class="hidden font-mono text-[0.68rem] text-paper-dim lg:inline" title="my local time">
      bhubaneswar · <span data-ist>--:--</span> IST
    </span>

    <div class="hidden items-center gap-6 font-mono text-[0.72rem] tracking-widest uppercase md:flex">
      {
        links.map((l) => (
          <a
            class={`transition-colors hover:text-accent ${isActive(l.href) ? 'text-accent' : 'text-paper-dim'}`}
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-4">
      <!-- the dual-lens rocker -->
      <button
        id="mode-toggle"
        class="group flex items-center gap-2 rounded-sm border border-line px-2.5 py-1.5 font-mono text-[0.7rem] transition-colors hover:border-accent"
        aria-label="Toggle between build and break mode"
        title="dual_use=true"
      >
        <span class="mode-opt mode-build text-accent">BUILD</span>
        <span class="text-line">/</span>
        <span class="mode-opt mode-break text-paper-dim">BREAK</span>
      </button>

      <button
        id="terminal-hint"
        class="hidden items-center gap-1.5 font-mono text-[0.7rem] text-paper-dim transition-colors hover:text-accent md:flex"
        aria-label="Open terminal"
      >
        <span class="rounded-sm border border-line px-1.5 py-0.5">~</span>
        <span>terminal</span>
      </button>
    </div>
  </div>

  <!-- mobile page links -->
  <div class="flex items-center gap-5 overflow-x-auto border-t border-line px-5 py-2 font-mono text-[0.68rem] tracking-widest uppercase md:hidden">
    {
      links.map((l) => (
        <a
          class={`whitespace-nowrap transition-colors ${isActive(l.href) ? 'text-accent' : 'text-paper-dim'}`}
          href={l.href}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  html[data-mode='break'] .mode-build { color: var(--color-paper-dim); }
  html[data-mode='break'] .mode-break { color: var(--accent); }

  /* first-visit coach mark — explains the rocker once, then never again */
  #mode-coach {
    position: fixed;
    top: 3.9rem;
    right: 1rem;
    z-index: 60;
    width: 15.5rem;
    background: var(--color-ink-2);
    border: 1px solid var(--accent);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.55;
    color: var(--color-paper-dim);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }
  #mode-coach.show { opacity: 1; transform: none; pointer-events: auto; }
  #mode-coach::before {
    content: '';
    position: absolute;
    top: -5px;
    right: 4.5rem;
    width: 8px;
    height: 8px;
    background: var(--color-ink-2);
    border-left: 1px solid var(--accent);
    border-top: 1px solid var(--accent);
    transform: rotate(45deg);
  }
</style>

<!-- one site, two personalities — told once -->
<div id="mode-coach" role="status">
  <p><span class="text-accent">this site has two modes.</span></p>
  <p class="mt-1"><span class="text-paper">BUILD</span> — the engineer who trains models.<br /><span class="text-paper">BREAK</span> — the one who attacks them.</p>
  <p class="mt-1">flip the switch ↑ and everything re-frames.</p>
  <button id="mode-coach-try" class="mt-2 w-full rounded-sm border border-line px-2 py-1 text-paper transition-colors hover:border-accent hover:text-accent">try it now</button>
</div>

<script>
  import { toggleMode } from './mode';

  // delegated — nav is re-rendered on every page turn, listeners must not die
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('#mode-toggle')) toggleMode();
    else if (t.closest('#terminal-hint')) document.dispatchEvent(new CustomEvent('terminal:open'));
  });

  // the logo breathes: "Aaron" deletes itself and retypes, every so often
  let logoTimer: number | undefined;
  function logoLoop() {
    const el = document.querySelector<HTMLElement>('[data-logo]');
    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const word = 'Aaron';
    let phase: 'wait' | 'del' | 'type' = 'wait';
    let n = word.length;
    const step = () => {
      if (phase === 'wait') { phase = 'del'; logoTimer = window.setTimeout(step, 6000); return; }
      if (phase === 'del') {
        n--;
        el.textContent = word.slice(0, n);
        if (n === 0) { phase = 'type'; logoTimer = window.setTimeout(step, 500); }
        else logoTimer = window.setTimeout(step, 85);
        return;
      }
      n++;
      el.textContent = word.slice(0, n);
      if (n === word.length) { phase = 'wait'; logoTimer = window.setTimeout(step, 30); }
      else logoTimer = window.setTimeout(step, 120);
    };
    logoTimer = window.setTimeout(step, 3500);
  }

  document.addEventListener('astro:page-load', () => {
    if (logoTimer) clearTimeout(logoTimer);
    logoLoop();

    // first visit only: pulse the rocker, then explain it in words
    try {
      if (!localStorage.getItem('nudged')) {
        setTimeout(() => {
          document.getElementById('mode-toggle')?.classList.add('nudge');
          document.getElementById('mode-coach')?.classList.add('show');
          localStorage.setItem('nudged', '1');
        }, 4500);
      }
    } catch {}
  });

  // coach mark: "try it" flips the mode; any click or flip dismisses it
  const dismissCoach = () => document.getElementById('mode-coach')?.classList.remove('show');
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('#mode-coach-try')) { toggleMode(); dismissCoach(); }
    else if (!t.closest('#mode-coach')) dismissCoach();
  });
  document.addEventListener('modechange', dismissCoach);
  setTimeout(dismissCoach, 30000); // never nag
</script>
