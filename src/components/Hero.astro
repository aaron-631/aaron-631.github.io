---
// Hero — one statement, nothing else competing for attention.
// The full thesis is always visible; the mode decides which half is lit.
// Clicking the dim half switches the lens. That IS the navigation.
import { profile } from '../content/profile';
---

<section id="top" class="relative mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-5 pt-14">
  <div class="hero-stagger">
    <p class="label-mono mb-8">aaron chakraborty · {profile.title.toLowerCase()} · kiit '27</p>

    <h1 class="h-serif text-[2.7rem] leading-[1.12] sm:text-6xl lg:text-[4.6rem]">
      <button class="hero-line hero-line-build block text-left" data-set-mode="build">I build AI systems.</button>
      <button class="hero-line hero-line-break block text-left" data-set-mode="break">Then I break them.</button>
    </h1>
    <p class="mt-4 font-mono text-[0.7rem] text-paper-dim">
      <span class="m-build">← that second line is clickable. everything changes.</span>
      <span class="m-break">← so is the first one. two sides, same person.</span>
    </p>

    <p class="mt-9 max-w-xl text-[1.05rem] leading-relaxed text-paper-dim">
      <span class="m-build">{profile.hero.build.sub}</span>
      <span class="m-break">{profile.hero.break.sub}</span>
    </p>

    <div class="mt-11 flex flex-wrap items-center gap-5">
      <a
        href={profile.links.resume}
        class="rounded-sm bg-accent px-5 py-2.5 font-mono text-[0.8rem] font-medium text-ink transition-opacity hover:opacity-85"
        title="opens right here · download button inside"
      >
        resume.pdf →
      </a>
      <span class="hidden font-mono text-[0.72rem] text-paper-dim sm:inline">
        or press <kbd class="rounded-sm border border-line px-1.5 py-0.5">~</kbd> and type <span class="text-accent">scan me</span>
      </span>
    </div>
  </div>

  <!-- quiet scroll cue -->
  <a
    href="#receipt"
    class="absolute bottom-8 left-5 font-mono text-[0.7rem] text-paper-dim transition-colors hover:text-accent"
    aria-label="Scroll to the proof"
  >
    <span class="mr-2 inline-block animate-bounce">↓</span>the proof
  </a>
</section>

<style>
  .hero-line {
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: var(--color-paper);
    transition: color 0.35s ease, opacity 0.35s ease;
  }
  /* the inactive half sits back until you reach for it */
  html[data-mode='build'] .hero-line-break,
  html[data-mode='break'] .hero-line-build {
    color: var(--color-paper-dim);
    opacity: 0.38;
  }
  html[data-mode='build'] .hero-line-break:hover,
  html[data-mode='break'] .hero-line-build:hover {
    opacity: 0.75;
  }
  html[data-mode='build'] .hero-line-build,
  html[data-mode='break'] .hero-line-break {
    color: var(--accent);
  }
</style>

<script>
  import { setMode } from './mode';
  import type { Mode } from './mode';
  // delegated: survives client-side page turns
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-set-mode]');
    if (b) setMode(b.dataset.setMode as Mode);
  });
</script>
