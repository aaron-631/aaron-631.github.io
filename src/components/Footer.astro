---
// Footer, quiet, grounded, human. Location, live clock, real pings.
// The pings aren't decoration: they're measured from YOUR browser, right now.
// On phones it stays out of the way: two short lines, one ping strip.
import { profile } from '../content/profile';
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-6xl px-5 py-8 font-mono text-[0.7rem] text-paper-dim sm:py-10 sm:text-[0.72rem]">
    <div class="flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center">
      <div class="flex flex-col gap-1">
        <p>© 2026 <span class="text-paper">Aaron Chakraborty</span><span class="hidden sm:inline"> · designed & written by me, mostly after midnight</span></p>
        <p>
          bhubaneswar · <span data-ist>--:--</span> IST
          <span class="mx-2 text-line">|</span>
          <span class="text-ok">●</span> <span data-swap data-build="mode: build" data-break="mode: break"></span>
        </p>
        <p class="sm:hidden opacity-70">designed & written by me, mostly after midnight</p>
      </div>

      <div class="flex items-center gap-4 sm:gap-5">
        <a class="link" href="/hire/">hiring?</a>
        <a class="link" href={profile.links.github} target="_blank" rel="noopener">github</a>
        <a class="link" href={profile.links.linkedin} target="_blank" rel="noopener">linkedin</a>
        <a class="link" href={profile.links.x} target="_blank" rel="noopener">x</a>
        <a class="link" href={profile.links.email}>email</a>
        <button
          class="rounded-sm border border-line px-1.5 py-0.5 transition-colors hover:border-accent hover:text-accent"
          aria-label="Open terminal"
          onclick="document.dispatchEvent(new CustomEvent('terminal:open'))"
        >~</button>
      </div>
    </div>

    <!-- live telemetry, measured from the visitor's browser, not hardcoded -->
    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1.5 border-t border-dashed border-line pt-3.5 text-[0.66rem] sm:mt-6 sm:gap-x-6 sm:pt-4 sm:text-[0.68rem]" id="pings" title="measured live from your browser">
      <span><span class="t-ok">●</span> site <span data-ping="site" class="text-paper">…</span></span>
      <span><span class="t-ok">●</span> loaded <span data-ping="load" class="text-paper">…</span></span>
      <span class="hidden opacity-60 sm:inline">// yes, these are real. refresh and watch them change.</span>
      <span class="opacity-60 sm:hidden">// real, measured now</span>
    </div>
  </div>
</footer>

<script>
  // Live latency, measured per visit. Static site: the "db" is GitHub's edge.
  function fmt(ms: number) {
    return `${Math.max(1, Math.round(ms))}ms`;
  }

  // measured once per visit, remembered across page turns (the footer DOM
  // is re-rendered on every turn, so re-apply the cached numbers each time)
  const vals: Record<string, string> = {};
  let measuring = false;

  async function measure() {
    const set = (k: string, v: string) => {
      vals[k] = v;
      document.querySelectorAll(`[data-ping="${k}"]`).forEach((el) => (el.textContent = v));
    };
    // re-apply what we already know
    for (const [k, v] of Object.entries(vals)) set(k, v);
    if (measuring) return;
    measuring = true;

    // how long the first page took, navigation start to full load
    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    if (nav && nav.loadEventEnd > 0) set('load', fmt(nav.loadEventEnd - nav.startTime));
    else set('load', fmt(performance.now()));

    // round-trip to this site's own edge (tiny asset, cache-busted)
    try {
      const t0 = performance.now();
      await fetch(`/favicon.svg?p=${Date.now()}`, { cache: 'no-store' });
      set('site', fmt(performance.now() - t0));
    } catch { set('site', 'offline?'); }
  }

  document.addEventListener('astro:page-load', measure);
</script>
