---
// Stats strip + Work timeline. Asymmetric editorial: role left, receipt right.
import { stats } from '../content/profile';
import { experience } from '../content/experience';
---

<section class="border-y border-line bg-ink-2">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-px px-5 py-8 font-mono sm:grid-cols-5">
    {
      stats.map((s) => (
        <div class="reveal py-3 pr-6">
          <div class="text-2xl text-accent">{s.value}</div>
          <div class="mt-1 text-[0.68rem] tracking-wider text-paper-dim uppercase">{s.label}</div>
        </div>
      ))
    }
  </div>
</section>

<section id="work" class="mx-auto max-w-6xl px-5 py-24">
  <p class="label-mono reveal mb-3"><span class="idx">// 01</span> <span data-swap data-build="— work" data-break="— operations"></span></p>
  <h2 class="h-serif reveal mb-4 text-4xl sm:text-5xl">Claims are cheap.<br />Here are the receipts.</h2>
  <p class="reveal mb-14 max-w-lg text-paper-dim">
    I don't like adjectives on portfolios — anyone can type "passionate". So every line below
    comes with the thing that proves it: a number, a report, a fix that shipped.
  </p>

  <div class="space-y-0">
    {
      experience.map((r) => (
        <article class={`reveal grid grid-cols-1 gap-4 border-t border-line py-8 md:grid-cols-[0.9fr_1.6fr_0.9fr] ${r.featured ? 'md:bg-ink-2/40' : ''}`}>
          <div class="font-mono text-[0.75rem] text-paper-dim">
            <div>{r.dates}</div>
            <div class="mt-1 opacity-70">{r.where}</div>
          </div>
          <div>
            <h3 class="text-lg font-semibold">
              {r.role}
              {r.featured && <span class="ml-2 align-middle font-mono text-[0.6rem] tracking-widest text-accent uppercase">● current-era</span>}
            </h3>
            <p class="mt-0.5 font-mono text-[0.8rem] text-paper-dim">{r.org}</p>
            <ul class="mt-3 space-y-2 text-[0.92rem] text-paper-dim">
              {r.points.map((p) => (
                <li class="flex gap-2.5">
                  <span class="mt-[0.55rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="md:text-right">
            {r.receipt && (
              <span class="inline-block border-l-2 border-accent bg-accent/8 px-3 py-1.5 font-mono text-[0.7rem] text-paper-dim md:border-r-2 md:border-l-0">
                {r.receipt}
              </span>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
