---
// The disclosure — a real production security finding as a case study.
import { disclosure } from '../content/projects';
---

<section id="disclosure" class="mx-auto max-w-6xl px-5 py-24">
  <p class="label-mono reveal mb-3"><span class="idx">// 03</span> — the disclosure</p>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1fr]">
    <div>
      <h2 class="h-serif reveal text-4xl sm:text-5xl">One real bug in production<br />beats ten toy projects.</h2>
      <p class="reveal mt-6 max-w-lg text-paper-dim">
        I found a reflected XSS in the AI chatbot of Yatra.com — a travel platform millions of
        people use. I reported it quietly, their security team confirmed it, and they fixed it.
        No drama, no clout-chasing thread. Just the job done right.
      </p>
      <p class="reveal mt-6 max-w-lg border-l-2 border-accent pl-4 text-[0.95rem] text-paper italic">
        {disclosure.moral}
      </p>
    </div>

    <div class="pane reveal self-center">
      <div class="pane-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="ml-2">cat disclosures/yatra-diya-xss.md</span>
      </div>
      <div class="pane-body">
        <p class="t-warn"># {disclosure.title}</p>
        <p class="t-dim mt-2">class: reflected XSS · surface: AI chatbot input path</p>
        <div class="mt-4 space-y-1.5">
          {
            disclosure.timeline.map((t, i) => (
              <p>
                <span class="t-dim">[{i + 1}/4]</span>
                <span class={t.step === 'remediated' ? 't-ok' : 'text-paper'}> {t.step}</span>
                <span class="t-dim"> — {t.note}</span>
              </p>
            ))
          }
        </div>
        <p class="mt-4"><span class="t-ok">status: closed ✓</span> <span class="t-dim">· vendor-acknowledged</span></p>
      </div>
    </div>
  </div>
</section>
