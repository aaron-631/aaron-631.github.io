---
// Landing — one idea per screen. Hero → the receipt → doors into the chapters.
// Everything else lives on its own page now. The landing just makes you feel it.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Receipt from '../components/Receipt.astro';
import { statsByMode } from '../content/profile';
import { chapters } from '../content/chapters';
---

<Base intro>
  <main>
    <Hero />
    <Receipt />

    <!-- the numbers, re-lensed per mode -->
    <section class="border-t border-line bg-ink-2">
      <div class="mx-auto max-w-6xl px-5 py-10 font-mono">
        <div class="m-build grid grid-cols-2 gap-px sm:grid-cols-4">
          {
            statsByMode.build.map((s) => (
              <div class="reveal py-3 pr-6">
                <div class="text-2xl text-accent" data-count={s.value}>{s.value}</div>
                <div class="mt-1 text-[0.68rem] tracking-wider text-paper-dim uppercase">{s.label}</div>
              </div>
            ))
          }
        </div>
        <div class="m-break grid grid-cols-2 gap-px sm:grid-cols-4">
          {
            statsByMode.break.map((s) => (
              <div class="py-3 pr-6">
                <div class="text-2xl text-accent" data-count={s.value}>{s.value}</div>
                <div class="mt-1 text-[0.68rem] tracking-wider text-paper-dim uppercase">{s.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- doors into the chapters — the site is a story, pick where to enter -->
    <section class="mx-auto max-w-6xl px-5 py-28">
      <p class="label-mono reveal mb-3"><span class="idx">//</span> the chapters</p>
      <h2 class="h-serif reveal mb-16 text-4xl sm:text-5xl">Where do you<br />want to start?</h2>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          chapters.map((c) => (
            <a
              href={c.href}
              class="reveal group flex flex-col justify-between border border-line bg-ink p-7 transition-colors hover:border-accent/60"
            >
              <div>
                <p class="label-mono mb-4"><span class="idx">// {c.idx}</span></p>
                <h3 class="h-serif text-2xl text-paper">{c.title}</h3>
                <p class="mt-3 text-[0.9rem] leading-relaxed text-paper-dim">{c.hook}</p>
              </div>
              <p class="mt-8 font-mono text-[0.75rem] text-paper-dim transition-colors group-hover:text-accent">
                <span class="t-prompt">$ </span>{c.cmd}
                <span class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
              </p>
            </a>
          ))
        }

        <!-- the sixth door is the terminal itself -->
        <button
          class="reveal group flex flex-col justify-between border border-dashed border-line bg-ink p-7 text-left transition-colors hover:border-accent/60"
          onclick="document.dispatchEvent(new CustomEvent('terminal:open'))"
        >
          <div>
            <p class="label-mono mb-4"><span class="idx">// ??</span></p>
            <h3 class="h-serif text-2xl text-paper">Skip the pages</h3>
            <p class="mt-3 text-[0.9rem] leading-relaxed text-paper-dim">
              The whole site runs from a shell. Some things only exist in there.
            </p>
          </div>
          <p class="mt-8 font-mono text-[0.75rem] text-paper-dim transition-colors group-hover:text-accent">
            <span class="t-prompt">~ </span>open terminal
            <span class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
          </p>
        </button>
      </div>
    </section>
  </main>
</Base>

<script>
  // stats count up from zero when they enter view — numbers you watch arrive
  document.addEventListener('astro:page-load', () => {
    const els = document.querySelectorAll<HTMLElement>('[data-count]:not([data-counted])');
    if (!els.length || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const animate = (el: HTMLElement) => {
      const target = el.dataset.count ?? '';
      const m = target.match(/^([^\d]*)([\d,.]+)(.*)$/);
      if (!m) return; // "AIR 45" etc. — leave non-leading-number values alone
      const [, prefix, numStr, suffix] = m;
      const hasComma = numStr.includes(',');
      const hasDot = numStr.includes('.');
      const end = parseFloat(numStr.replace(/,/g, ''));
      const t0 = performance.now();
      const dur = 900;
      const step = (t: number) => {
        const p = Math.min((t - t0) / dur, 1);
        const eased = 1 - Math.pow(1 - p, 3);
        let v = end * eased;
        let text = hasDot ? v.toFixed(numStr.split('.')[1].length) : String(Math.round(v));
        if (hasComma) text = Number(text).toLocaleString('en-US');
        el.textContent = prefix + text + suffix;
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = target;
      };
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement;
            el.dataset.counted = '1';
            animate(el);
            io.unobserve(el);
          }
        }
      },
      { threshold: 0.6 }
    );
    els.forEach((el) => io.observe(el));
  });
</script>
