---
// Contact — every door visible at first glance, email loudest.
// The Argus scan and the terminal come after; they're the dessert.
import Base from '../layouts/Base.astro';
import ChapterNav from '../components/ChapterNav.astro';
import { profile } from '../content/profile';

// inline SVGs — no icon library, no extra requests
const icons: Record<string, string> = {
  email:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>',
  linkedin:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.5 8h4V24h-4V8zm7.5 0h3.8v2.2h.1c.5-1 1.8-2.2 3.8-2.2 4 0 4.8 2.6 4.8 6V24h-4v-8.5c0-2-.04-4.7-2.9-4.7-2.9 0-3.3 2.2-3.3 4.5V24H8V8z"/></svg>',
  github:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.7 5.5.7 11.8c0 5 3.2 9.2 7.7 10.7.6.1.8-.2.8-.5v-2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.7 1.2 3.3.9.1-.7.4-1.2.7-1.5-2.5-.3-5.2-1.3-5.2-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0C17 4.7 18 5 18 5c.6 1.6.2 2.8.1 3 .8.9 1.2 1.9 1.2 3.2 0 4.4-2.7 5.4-5.2 5.7.4.4.8 1 .8 2.1v3.1c0 .3.2.7.8.5a11.3 11.3 0 0 0 7.6-10.7C23.3 5.5 18.3.5 12 .5z"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.2h3.7l-8.1 9.3L24 22.8h-7.5l-5.9-7.7-6.7 7.7H.2l8.7-9.9L0 1.2h7.7l5.3 7 5.9-7zm-1.3 19.4h2L6.6 3.3H4.4l13.2 17.3z"/></svg>',
  tryhackme:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 4 7v5c0 4.4 3.4 8.5 8 9.5 4.6-1 8-5.1 8-9.5V7l-8-4z"/><path d="m9 12 2 2 4-4"/></svg>',
  resume:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 2h9l5 5v15H6z"/><path d="M15 2v5h5"/><path d="M9 13h8M9 17h8M9 9h3"/></svg>',
};

const ways = [
  {
    key: 'linkedin',
    label: 'linkedin',
    value: 'aaron-chakraborty',
    note: 'recruiter-friendly, full history',
    href: profile.links.linkedin,
    external: true,
  },
  {
    key: 'github',
    label: 'github',
    value: 'aaron-631',
    note: 'the code behind every claim here',
    href: profile.links.github,
    external: true,
  },
  {
    key: 'x',
    label: 'x / twitter',
    value: '@AaronChakr47884',
    note: 'build-in-public, crashes included',
    href: profile.links.x,
    external: true,
  },
  {
    key: 'tryhackme',
    label: 'tryhackme',
    value: 'aaronchakraborty',
    note: 'where the breaking gets practiced',
    href: profile.links.tryhackme,
    external: true,
  },
  {
    key: 'resume',
    label: 'resume',
    value: 'resume.pdf',
    note: 'opens right here · download inside',
    href: profile.links.resume,
    external: false,
  },
];
---

<Base title="Contact · Aaron Chakraborty" description="Placement season 2026-27. AI/ML engineering, security engineering, or the rare seat that needs both.">
  <main class="pt-24 md:pt-14">
    <!-- reach me — first thing, no hunting -->
    <section class="mx-auto max-w-6xl px-5 py-24">
      <p class="label-mono reveal mb-3"><span class="idx">// 06</span> · contact</p>
      <h1 class="h-serif reveal text-4xl sm:text-5xl">Let's talk.</h1>
      <p class="reveal mt-6 max-w-lg leading-relaxed text-paper-dim">
        Placement season 2026-27. If you're hiring for AI/ML engineering, security engineering,
        or the rare seat that needs both — every door is right here.
      </p>

      <!-- email: the headline act, impossible to miss -->
      <div class="reveal contact-hero mt-12">
        <div class="flex items-center gap-3">
          <span class="contact-ico contact-ico-lg" set:html={icons.email} />
          <p class="label-mono">email · the fast lane</p>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a
            href={profile.links.email}
            class="break-all font-mono text-xl text-paper transition-colors hover:text-accent sm:text-3xl"
          >aaronchakraborty631@gmail.com</a>
          <div class="flex gap-2.5">
            <a href={profile.links.email} class="btn-accent">write to me →</a>
            <button class="btn-ghost" data-copy-email data-mail={profile.email}>copy address</button>
          </div>
        </div>
        <p class="mt-3 font-mono text-[0.72rem] text-paper-dim">i reply quick. usually the same day, often within the hour.</p>
      </div>

      <!-- everything else, one glance -->
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          ways.map((w) => (
            <a
              href={w.href}
              target={w.external ? '_blank' : undefined}
              rel={w.external ? 'noopener' : undefined}
              class="contact-card reveal group"
            >
              <div class="flex items-center gap-3">
                <span class="contact-ico" set:html={icons[w.key]} />
                <div class="min-w-0">
                  <p class="label-mono">{w.label}</p>
                  <p class="mt-1 truncate font-mono text-[1.02rem] text-paper transition-colors group-hover:text-accent">{w.value}</p>
                </div>
                <span class="ml-auto text-paper-dim transition-all group-hover:translate-x-1 group-hover:text-accent">→</span>
              </div>
              <p class="mt-3 text-[0.8rem] text-paper-dim">{w.note}</p>
            </a>
          ))
        }
      </div>
    </section>

    <!-- the Argus recruiter scan -->
    <section id="contact" class="border-t border-line bg-ink-2/30">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[0.9fr_1.1fr]">
          <div>
            <p class="label-mono reveal mb-3"><span class="idx">// 06.5</span> · the scan</p>
            <h2 class="h-serif reveal text-3xl sm:text-4xl">Still deciding?<br />Run the scan.</h2>
            <p class="reveal mt-6 max-w-md leading-relaxed text-paper-dim">
              Argus is my real tool for evaluating AI agents before deployment.
              This copy of it evaluates a different target: me. Thirty seconds,
              every finding true.
            </p>
          </div>

          <div class="reveal self-center">
            <div class="pane">
              <div class="pane-bar">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                <span class="ml-2">argus · candidate evaluation</span>
              </div>
              <div class="pane-body min-h-[21rem]" id="scan-out">
                <p class="t-dim">// Argus is my real pre-deployment risk evaluator.</p>
                <p class="t-dim">// This one runs on me.</p>
                <p class="mt-3"><span class="t-prompt">$ </span>argus scan --target aaron_chakraborty --profile recruiter</p>
              </div>
              <div class="border-t border-line p-3">
                <button
                  id="scan-btn"
                  class="w-full rounded-sm bg-accent px-4 py-2.5 font-mono text-[0.8rem] font-medium text-ink transition-opacity hover:opacity-85"
                >
                  ▶ run scan
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- the terminal, embedded — the thing that survived every redesign -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <p class="label-mono reveal mb-3"><span class="idx">// 06.9</span> · terminal</p>
        <h2 class="h-serif reveal mb-4 text-3xl sm:text-4xl">Prefer the command line?<br />Same here.</h2>
        <p class="reveal mb-10 max-w-md text-[0.95rem] leading-relaxed text-paper-dim">
          This shell has been on my site since v1. It's the one thing I refused to remove.
          Never used a terminal? Doesn't matter, it understands plain words, and the
          pills below it do the typing for you.
        </p>

        <div class="reveal max-w-2xl">
          <div class="pane">
            <div class="pane-bar">
              <span class="dot"></span><span class="dot"></span><span class="dot"></span>
              <span class="ml-2">aaron@portfolio</span>
            </div>
            <div class="pane-body h-[18rem] overflow-y-auto" id="term-out-embed"></div>
            <div class="flex items-center gap-2 border-t border-line px-4 py-2.5 font-mono text-[0.8rem]">
              <span class="t-prompt" data-prompt>aaron@build:~$</span>
              <input
                id="term-in-embed"
                class="w-full bg-transparent text-paper outline-none placeholder:text-paper-dim/40"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                placeholder="try: who are you?"
                aria-label="Terminal input"
              />
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <button class="cmd-chip" data-cmd="whoami">who are you?</button>
            <button class="cmd-chip" data-cmd="scan me">scan me</button>
            <button class="cmd-chip" data-cmd="history">life story</button>
            <button class="cmd-chip" data-cmd="neofetch">system info</button>
            <button class="cmd-chip" data-cmd="ls -la">secrets?</button>
          </div>
        </div>
      </div>
    </section>

    <ChapterNav />
  </main>
</Base>

<script>
  import { wireTerminal } from '../components/Terminal';

  document.addEventListener('astro:page-load', () => {
    wireTerminal('term-out-embed', 'term-in-embed');

    // copy-email button — instant feedback, no clipboard API drama
    const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
    if (copyBtn && !copyBtn.dataset.wired) {
      copyBtn.dataset.wired = '1';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(copyBtn.dataset.mail ?? '');
          const orig = copyBtn.textContent;
          copyBtn.textContent = '✓ copied';
          setTimeout(() => (copyBtn.textContent = orig), 1600);
        } catch {
          copyBtn.textContent = copyBtn.dataset.mail ?? '';
        }
      });
    }

    const OUT = document.getElementById('scan-out');
    const BTN = document.getElementById('scan-btn') as HTMLButtonElement | null;
    if (!OUT || !BTN || BTN.dataset.wired) return;
    BTN.dataset.wired = '1';

  const REPORT: Array<[string, string, number]> = [
    ['$ argus scan --target aaron_chakraborty --profile recruiter', 't-prompt', 300],
    ['[✓] static analysis .......... 15/15 rules passed', 't-dim', 350],
    ['[✓] identity verified ........ B.Tech CSE @ KIIT · CGPA 9.42', 't-dim', 300],
    ['', '', 120],
    ['[!] FINDING (CRITICAL) · builds end-to-end', 't-crit', 500],
    ['    trained 567,068,416-param MoE LLM from scratch · A100 · 30k steps', 't-dim', 260],
    ['[!] FINDING (HIGH) · breaks what others ship', 't-crit', 500],
    ['    disclosed reflected XSS in production AI chatbot → remediated', 't-dim', 260],
    ['[!] FINDING (HIGH) · performs under pressure', 't-crit', 500],
    ['    AIR 45 · top 0.90% · Pentathon 2025 (48-hour national CTF)', 't-dim', 260],
    ['[!] FINDING (MEDIUM) · certified offense', 't-warn', 400],
    ['    eJPTv2 91% · INE Security · SSB TES-51 AIR 83', 't-dim', 260],
    ['', '', 150],
    ['computing R = S_base × C_env × P_conf ...', 't-dim', 700],
    ['R = HIRE  (confidence: 0.99, clamped, never claims certainty)', 't-ok', 400],
    ['verdict: deploy immediately.', 't-ok', 300],
    ['exit 0', 't-dim', 200],
  ];

  let running = false;

  function runScan() {
    if (running || !OUT || !BTN) return;
    running = true;
    BTN.disabled = true;
    BTN.textContent = 'scanning…';
    OUT.innerHTML = '';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const finish = () => {
      const p = document.createElement('p');
      p.className = 'mt-3';
      p.innerHTML =
        '<span class="t-prompt">$ </span><a class="link" href="/resume.pdf" download="Aaron_Chakraborty_Resume.pdf">download resume.pdf</a> <span class="t-dim">·</span> <a class="link" href="mailto:aaronchakraborty631@gmail.com?subject=Saw%20the%20scan%20-%20let%27s%20talk">email aaron</a>';
      OUT.appendChild(p);
      BTN.disabled = false;
      BTN.textContent = '↻ re-run scan';
      running = false;
    };

    if (reduced) {
      for (const [text, cls] of REPORT) {
        const p = document.createElement('p');
        p.className = cls;
        p.textContent = text || ' ';
        OUT.appendChild(p);
      }
      finish();
      return;
    }

    let i = 0;
    const step = () => {
      if (i >= REPORT.length) return finish();
      const [text, cls, delay] = REPORT[i++];
      const p = document.createElement('p');
      p.className = cls;
      p.textContent = text || ' ';
      OUT.appendChild(p);
      OUT.scrollTop = OUT.scrollHeight;
      setTimeout(step, delay);
    };
    step();
  }

    BTN.addEventListener('click', runScan);
    // the terminal can trigger this too
    document.addEventListener('scan:run', () => {
      document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
      setTimeout(runScan, 600);
    });
  });
</script>
