---
import Base from '../layouts/Base.astro';
---

<Base title="404 · command not found" bare>
  <main class="mx-auto flex min-h-screen max-w-3xl items-center px-5">
    <div class="pane w-full">
      <div class="pane-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="ml-2">aaron@portfolio</span>
      </div>
      <div class="pane-body">
        <p><span class="t-prompt">aaron@build:~$ </span>cd {'{requested_page}'}</p>
        <p class="t-crit">bash: cd: no such file or directory (404)</p>
        <p class="t-dim mt-3"># this page doesn't exist. these do:</p>
        <p class="mt-2"><a class="link" href="/">cd ~/ &nbsp;# home</a></p>
        <p><a class="link" href="/projects/">cd ~/projects</a></p>
        <p><a class="link" href="/resume.pdf">cat resume.pdf</a></p>
        <p class="mt-3"><span class="t-prompt">aaron@build:~$ </span><span class="cursor-block"></span></p>
      </div>
    </div>
  </main>
</Base>
