---
// About, the person. Story, the lab family, the journey history.
// One chapter, room to breathe.
import Base from '../layouts/Base.astro';
import ChapterNav from '../components/ChapterNav.astro';
import { profile } from '../content/profile';
import { now } from '../content/writing';
import { journey } from '../content/achievements';
import { skills } from '../content/skills';

// the ones worth naming on the about page, the rest live in /projects/#arsenal
const headline = ['pytorch', 'transformers', 'deepspeed', 'burp', 'prompt-injection', 'python', 'react', 'bash'];
const toolkit = headline.map((id) => skills.find((s) => s.id === id)!).filter(Boolean);
---

<Base title="About · Aaron Chakraborty" description="The honest version: SSB AIR 83, the IoT Lab family at KIIT, and why I picked the hard road.">
  <main class="pt-24 md:pt-14">
    <!-- the story -->
    <section class="mx-auto grid max-w-6xl grid-cols-1 gap-14 px-5 py-24 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <div class="relative max-w-[20rem]">
          <img
            src="/photos/candid.jpg"
            alt="Aaron Chakraborty, mid-laugh at a lab session"
            width="720"
            height="1080"
            loading="eager"
            class="photo w-full"
            style="aspect-ratio: 3/4;"
          />
          <p class="photo-caption">
            <span class="t-prompt">$</span> whoami · bhubaneswar, india · est. 2005
          </p>
        </div>

        <!-- now block, dated, alive -->
        <div class="mt-12 border-l-2 border-accent pl-4">
          <p class="label-mono mb-2">now · {now.updated}</p>
          <ul class="space-y-1.5 font-mono text-[0.78rem] text-paper-dim">
            {now.items.map((i) => <li>→ {i}</li>)}
          </ul>
        </div>
      </div>

      <div>
        <p class="label-mono reveal mb-3"><span class="idx">// 01</span> <span data-swap data-build="· about" data-break="· subject profile"></span></p>
        <h1 class="h-serif reveal mb-10 text-4xl sm:text-5xl">
          <span class="m-build">The honest version.</span>
          <span class="m-break">The guy on the other side.</span>
        </h1>
        <div class="reveal space-y-6 text-[1.05rem] leading-[1.8] text-paper-dim">
          {profile.about.map((p) => <p>{p}</p>)}
          <p class="text-paper">
            <span class="m-build">{profile.aboutClose.build}</span>
            <span class="m-break">{profile.aboutClose.break}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- the toolkit, hover any of these, they explain themselves -->
    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-20">
        <p class="label-mono reveal mb-3"><span class="idx">// 01.2</span> · the toolkit</p>
        <h2 class="h-serif reveal mb-4 text-3xl sm:text-4xl">What I work with.</h2>
        <p class="reveal mb-10 max-w-lg text-[0.92rem] leading-relaxed text-paper-dim">
          Don't code? Hover (or tap) any of these. Each one tells you what it is in normal
          words, then shows you exactly where I used it. Full list lives in
          <a class="link" href="/projects/#arsenal">the arsenal</a>.
        </p>
        <div class="reveal flex flex-wrap gap-2.5">
          {toolkit.map((s) => (
            <button class="skill-chip px-3 py-1.5 text-[0.78rem]" data-skill={s.id} aria-expanded="false">{s.name}</button>
          ))}
        </div>
      </div>
    </section>

    <!-- the family, IoT Lab -->
    <section class="border-t border-line bg-ink-2/30">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <p class="label-mono reveal mb-3"><span class="idx">// 01.5</span> · the family</p>
        <h2 class="h-serif reveal mb-5 text-4xl sm:text-5xl">IoT Lab, KIIT.<br />My people.</h2>
        <div class="reveal mb-14 max-w-xl space-y-5 leading-relaxed text-paper-dim">
          <p>
            Every college has societies. IoT Lab is the one I gave two years to, first as a cybersecurity
            member, then as Lab Coordinator running the whole thing. 30+ members, CTFs, showcase days,
            onboarding juniors who reminded me of me when I started.
          </p>
          <p>
            My tenure wrapped up in August 2026 and the juniors run it now, which was always the plan.
            These are still the people who were there before anything worked. They saw the failed demos,
            the 3am debugging, the events that almost fell apart and didn't. Family is the only word
            that fits.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <figure class="reveal sm:col-span-2">
            <img
              src="/photos/lab-family.jpg"
              alt="Full IoT Lab group photo on the red steps at KIIT"
              width="1000" height="750" loading="lazy"
              class="photo aspect-[16/9] w-full object-cover"
            />
            <figcaption class="photo-caption"><span class="t-prompt">$</span> the whole lab. my job was keeping this running. their job was keeping me sane. now it's theirs.</figcaption>
          </figure>
          <figure class="reveal">
            <img
              src="/photos/iotlab.jpg"
              alt="Aaron and the app dev lead in custom coordinator tees, facing the crowd at a lab event"
              width="1000" height="750" loading="lazy"
              class="photo aspect-[4/3] w-full"
            />
            <figcaption class="photo-caption"><span class="t-prompt">$</span> the coordinator tee has my name on the back. still not over it.</figcaption>
          </figure>
          <figure class="reveal">
            <img
              src="/photos/event.jpg"
              alt="A lab showcase event at the KIIT amphitheatre"
              width="1100" height="499" loading="lazy"
              class="photo aspect-[4/3] w-full object-cover"
            />
            <figcaption class="photo-caption"><span class="t-prompt">$</span> showcase day at the amphitheatre. demos or it didn't happen.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- the journey -->
    <section class="mx-auto max-w-6xl px-5 py-24">
      <p class="label-mono reveal mb-3"><span class="idx">// 01.9</span> · journey</p>
      <h2 class="h-serif reveal mb-14 text-4xl sm:text-5xl">$ history</h2>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="pane reveal self-start">
          <div class="pane-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="ml-2">~/.aaron_history</span>
          </div>
          <div class="pane-body space-y-2">
            {
              journey.map((h, i) => (
                <p class="group grid grid-cols-[2rem_5.5rem_1fr] gap-2 sm:grid-cols-[2.5rem_6.5rem_1fr]">
                  <span class="t-dim text-right">{i + 1}</span>
                  <span class="t-dim">{h.date}</span>
                  <span>
                    <span class={h.kind === 'achievement' ? 't-warn' : h.kind === 'cert' ? 't-ok' : 'text-paper'}>{h.cmd}</span>
                    <span class="t-dim block pl-0 sm:inline sm:pl-2"># {h.note}</span>
                  </span>
                </p>
              ))
            }
            <p class="pt-2"><span class="t-prompt">$ </span><span class="cursor-block"></span></p>
          </div>
        </div>

        <figure class="reveal self-start">
          <img
            src="/photos/podium.jpg"
            alt="Aaron speaking at a KIIT University podium"
            width="1000" height="666" loading="lazy"
            class="photo w-full"
          />
          <figcaption class="photo-caption">
            <span class="t-prompt">$</span> echo "some entries in that history happened on a stage"
          </figcaption>
        </figure>
      </div>
    </section>

    <ChapterNav />
  </main>
</Base>
