---
// Projects — flagship dossier + cards that open into a reading panel + arsenal.
import Base from '../layouts/Base.astro';
import ChapterNav from '../components/ChapterNav.astro';
import { projects, lab } from '../content/projects';
import { arsenal } from '../content/writing';
import { findSkill } from '../content/skills';

const flagship = projects.find((p) => p.flagship)!;
const rest = projects.filter((p) => !p.flagship);

// which arsenal / stack labels get a plain-words popover
const skillId = (label: string) => findSkill(label)?.id ?? null;

const ARCH = `  ┌────────────────────────────────────────────┐
  │ VantaLLM · decoder-only · 567,068,416 params│
  ├────────────────────────────────────────────┤
  │ tok(151,003) → emb → 12× [ RMSNorm         │
  │   → GQA + RoPE (shared lazy cache)         │
  │   → dense FFN ⇄ MoE 16e top-2              │
  │     (batched grouped-GEMM, cap=1.25) ]     │
  │ → RMSNorm → lm_head                        │
  ├────────────────────────────────────────────┤
  │ train: DDP / DeepSpeed ZeRO-2·3 · bf16     │
  │ serve: FastAPI · SSE · persona routing     │
  └────────────────────────────────────────────┘`;
---

<Base title="Projects · Aaron Chakraborty" description="VantaLLM: a 567M-param MoE LLM trained from scratch. Argus: AI-agent risk evaluation. ReconForge, Search Arena, and more.">
  <main class="pt-24 md:pt-14">
    <section class="mx-auto max-w-6xl px-5 py-24">
      <p class="label-mono reveal mb-3"><span class="idx">// 03</span> <span data-swap data-build="· things i built" data-break="· attack & defense tooling"></span></p>
      <h1 class="h-serif reveal mb-4 text-4xl sm:text-5xl">
        <span class="m-build">The systems.</span>
        <span class="m-break">The tools that break systems.</span>
      </h1>
      <p class="reveal mb-16 font-mono text-[0.75rem] text-paper-dim">
        tip: any tech chip with a <span class="text-accent">?</span> explains itself in plain words. cards open, click one.
      </p>

      <!-- flagship dossier -->
      <article id="vantallm" class="reveal grid grid-cols-1 gap-10 border border-line bg-ink p-7 md:p-12 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="font-mono text-2xl">{flagship.name}</h2>
            <span class="rounded-sm border border-line px-2 py-0.5 font-mono text-[0.65rem] tracking-wider text-paper-dim uppercase">private repo</span>
            <span class="font-mono text-[0.65rem] tracking-wider text-accent uppercase">flagship</span>
          </div>
          <p class="mt-5 leading-relaxed text-paper-dim">
            <span class="m-build">{flagship.oneliner.build}</span>
            <span class="m-break">{flagship.oneliner.break}</span>
          </p>
          <ul class="m-build mt-6 space-y-3 text-[0.94rem] leading-relaxed text-paper-dim">
            {flagship.points.build.map((p) => (
              <li class="flex gap-2.5">
                <span class="mt-[0.6rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <ul class="m-break mt-6 space-y-3 text-[0.94rem] leading-relaxed text-paper-dim">
            {flagship.points.break.map((p) => (
              <li class="flex gap-2.5">
                <span class="mt-[0.6rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
          <div class="mt-7 flex flex-wrap gap-2">
            {flagship.stack.map((s) =>
              skillId(s) ? (
                <button class="skill-chip px-2 py-1 text-[0.68rem]" data-skill={skillId(s)} aria-expanded="false">{s}</button>
              ) : (
                <span class="rounded-sm bg-ink-3 px-2 py-1 font-mono text-[0.68rem] text-paper-dim">{s}</span>
              )
            )}
          </div>
          <div class="mt-7 flex flex-wrap gap-2" data-proofs>
            {flagship.proofs.map((pr, i) => (
              <button class="proof-chip" aria-expanded="false" data-proof-idx={i} data-detail={pr.detail} data-href={pr.href ?? ''}>
                {pr.label}
              </button>
            ))}
          </div>
          <div class="proof-detail mt-3 hidden" data-proof-out></div>
          <p class="mt-7 font-mono text-[0.75rem] text-paper-dim">
            → <a class="link" href={flagship.links[0].href}>{flagship.links[0].label}</a>
          </p>
        </div>

        <div class="flex flex-col gap-6 self-center">
          <pre class="pane-body overflow-x-auto rounded-md border border-line bg-ink-2 font-mono text-[0.68rem] leading-snug text-paper-dim sm:text-[0.75rem]" aria-label="VantaLLM architecture diagram">{ARCH}</pre>
          <figure class="hidden lg:block">
            <img
              src="/photos/desk.jpg"
              alt="Aaron working on a laptop at a desk, another lab member alongside"
              width="900" height="1350" loading="lazy"
              class="photo max-h-64 w-full object-cover object-[center_35%]"
            />
            <figcaption class="photo-caption">
              <span class="t-prompt">$</span> where the debugging actually happens
            </figcaption>
          </figure>
        </div>
      </article>

      <!-- supporting cards — click one, it opens into a reading panel -->
      <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2">
        {
          rest.map((p) => (
            <article
              class="card-open reveal flex flex-col border border-line bg-ink p-7 transition-all hover:border-accent/50"
              data-card={p.id}
              tabindex="0"
              role="button"
              aria-haspopup="dialog"
              aria-label={`Open ${p.name} details`}
            >
              <div class="flex items-center justify-between">
                <h2 class="font-mono text-lg">{p.name}</h2>
                <span class={`font-mono text-[0.62rem] tracking-wider uppercase ${p.status === 'live' ? 't-ok' : 'text-paper-dim'}`}>
                  {p.status}
                </span>
              </div>
              <p class="mt-3 flex-grow text-[0.9rem] leading-relaxed text-paper-dim">
                <span class="m-build">{p.oneliner.build}</span>
                <span class="m-break">{p.oneliner.break}</span>
              </p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {p.stack.slice(0, 4).map((s) => (
                  <span class="rounded-sm bg-ink-3 px-1.5 py-0.5 font-mono text-[0.62rem] text-paper-dim">{s}</span>
                ))}
              </div>
              <p class="mt-5 font-mono text-[0.72rem] text-paper-dim transition-colors group-hover:text-accent">
                <span class="t-prompt">$ </span>open {p.id}
                <span class="ml-1 inline-block">→</span>
              </p>
            </article>
          ))
        }
      </div>

      <!-- more in the lab -->
      <div class="reveal mt-12 border-t border-dashed border-line pt-6 font-mono text-[0.78rem] text-paper-dim">
        <span class="text-accent">more in the lab:</span>
        {lab.map((l, i) => (
          <>
            {i > 0 && ' · '}
            <a class="link" href={l.href} target="_blank" rel="noopener" title={l.note}>{l.name}</a>
          </>
        ))}
      </div>
    </section>

    <!-- the dossier panel — projects open here, centre stage -->
    <div id="dossier" role="dialog" aria-modal="true" aria-label="Project details">
      <div class="dossier-card">
        {
          rest.map((p) => (
            <div class="dossier-page hidden p-7 md:p-10" data-dossier={p.id}>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    <h2 class="font-mono text-2xl">{p.name}</h2>
                    <span class={`font-mono text-[0.62rem] tracking-wider uppercase ${p.status === 'live' ? 't-ok' : 'text-paper-dim'}`}>{p.status}</span>
                  </div>
                </div>
                <button class="dossier-close shrink-0 rounded-sm border border-line px-2.5 py-1 font-mono text-[0.8rem] text-paper-dim transition-colors hover:border-accent hover:text-accent" aria-label="Close">esc ✕</button>
              </div>

              <p class="mt-5 leading-relaxed text-paper-dim">
                <span class="m-build">{p.oneliner.build}</span>
                <span class="m-break">{p.oneliner.break}</span>
              </p>

              <ul class="m-build mt-6 space-y-3 text-[0.92rem] leading-relaxed text-paper-dim">
                {p.points.build.map((pt) => (
                  <li class="flex gap-2.5">
                    <span class="mt-[0.6rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>
              <ul class="m-break mt-6 space-y-3 text-[0.92rem] leading-relaxed text-paper-dim">
                {p.points.break.map((pt) => (
                  <li class="flex gap-2.5">
                    <span class="mt-[0.6rem] h-px w-3 shrink-0 bg-accent" aria-hidden="true" />
                    <span>{pt}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-6 flex flex-wrap gap-2">
                {p.stack.map((s) =>
                  skillId(s) ? (
                    <button class="skill-chip px-2 py-1 text-[0.68rem]" data-skill={skillId(s)} aria-expanded="false">{s}</button>
                  ) : (
                    <span class="rounded-sm bg-ink-3 px-2 py-1 font-mono text-[0.68rem] text-paper-dim">{s}</span>
                  )
                )}
              </div>

              <div class="mt-6 flex flex-wrap gap-2" data-proofs>
                {p.proofs.map((pr) => (
                  <button class="proof-chip" aria-expanded="false" data-detail={pr.detail} data-href={pr.href ?? ''}>
                    {pr.label}
                  </button>
                ))}
              </div>
              <div class="proof-detail mt-3 hidden" data-proof-out></div>

              <p class="mt-7 border-t border-dashed border-line pt-5 font-mono text-[0.78rem]">
                {p.links.map((l, i) => (
                  <>
                    {i > 0 && <span class="text-line"> · </span>}
                    <a class="link" href={l.href} target="_blank" rel="noopener">{l.label}</a>
                  </>
                ))}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <!-- arsenal -->
    <section id="arsenal" class="border-t border-line bg-ink-2/30">
      <div class="mx-auto max-w-6xl px-5 py-24">
        <p class="label-mono reveal mb-3"><span class="idx">// 03.5</span> · arsenal</p>
        <h2 class="h-serif reveal mb-4 text-4xl sm:text-5xl">The toolkit.</h2>
        <p class="reveal mb-3 max-w-md font-mono text-[0.8rem] text-paper-dim">
          No skill bars, no percentages. If it's listed here, I've shipped something with it.
        </p>
        <p class="reveal mb-14 max-w-md font-mono text-[0.72rem] text-paper-dim opacity-70">
          (in terminal-speak this section is <span class="text-accent">man aaron</span> — my manual page.
          hover anything with a <span class="text-accent">?</span> and it explains itself in plain words.)
        </p>

        <div class="grid grid-cols-1 gap-10 font-mono md:grid-cols-3">
          {
            Object.entries(arsenal).map(([group, items]) => (
              <div class="reveal">
                <h3 class="mb-4 text-[0.72rem] tracking-widest text-accent uppercase">{group}</h3>
                <ul class="space-y-1.5 text-[0.82rem] text-paper-dim">
                  {items.map((i) =>
                    skillId(i) ? (
                      <li>
                        <button class="skill-chip w-full border-l border-line bg-transparent pl-3 text-left" data-skill={skillId(i)} aria-expanded="false" style="border-radius:0">
                          {i}
                        </button>
                      </li>
                    ) : (
                      <li class="border-l border-line pl-3 transition-colors hover:border-accent hover:text-paper">{i}</li>
                    )
                  )}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <ChapterNav />
  </main>
</Base>

<style>
  /* BREAK mode: attack tooling leads */
  html[data-mode='break'] [data-card='argus'] { order: -2; }
  html[data-mode='break'] [data-card='reconforge'] { order: -1; }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // ── dossier panel: card → centre-stage reading panel ──
    const dossier = document.getElementById('dossier');
    if (dossier && !dossier.dataset.wired) {
      dossier.dataset.wired = '1';
      let lastFocus: HTMLElement | null = null;

      const open = (id: string) => {
        dossier.querySelectorAll<HTMLElement>('.dossier-page').forEach((pg) => {
          pg.classList.toggle('hidden', pg.dataset.dossier !== id);
        });
        dossier.classList.add('open');
        document.body.style.overflow = 'hidden';
        (dossier.querySelector('.dossier-page:not(.hidden) .dossier-close') as HTMLElement | null)?.focus();
      };
      const close = () => {
        dossier.classList.remove('open');
        document.body.style.overflow = '';
        lastFocus?.focus();
      };

      document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
        const go = () => {
          lastFocus = card;
          open(card.dataset.card!);
        };
        card.addEventListener('click', (e) => {
          // links inside a card still work normally
          if ((e.target as HTMLElement).closest('a')) return;
          go();
        });
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
        });
      });
      dossier.querySelectorAll('.dossier-close').forEach((b) => b.addEventListener('click', close));
      dossier.addEventListener('click', (e) => { if (e.target === dossier) close(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && dossier.classList.contains('open')) close();
      });
      document.addEventListener('astro:before-swap', close);
    }

    // ── proof chip expansion — one open at a time per group ──
    document.querySelectorAll('[data-proofs]').forEach((wrap) => {
      if ((wrap as HTMLElement).dataset.wired) return;
      (wrap as HTMLElement).dataset.wired = '1';
      const out = wrap.parentElement?.querySelector('[data-proof-out]') as HTMLElement | null;
      if (!out) return;
      wrap.querySelectorAll<HTMLButtonElement>('.proof-chip').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = btn.getAttribute('aria-expanded') === 'true';
          wrap.querySelectorAll('.proof-chip').forEach((b) => b.setAttribute('aria-expanded', 'false'));
          if (open) {
            out.classList.add('hidden');
            return;
          }
          btn.setAttribute('aria-expanded', 'true');
          const href = btn.dataset.href;
          out.textContent = btn.dataset.detail ?? '';
          if (href) {
            const a = document.createElement('a');
            a.href = href;
            a.target = '_blank';
            a.rel = 'noopener';
            a.className = 'link';
            a.textContent = ' → open';
            out.appendChild(a);
          }
          out.classList.remove('hidden');
        });
      });
    });
  });
</script>
